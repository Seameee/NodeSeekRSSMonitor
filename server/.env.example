# ============================================================================
# NodeSeek 关键词监控 Bot — 环境变量
#
# 复制为 .env 后填写：cp .env.example .env
# 带 ★ 的是必填项
# ============================================================================

# ─── 必填 ────────────────────────────────────────────────────────────────────

# ★ Telegram Bot Token，从 @BotFather 获取
TELEGRAM_BOT_TOKEN=

# 管理员 Telegram 用户 ID，多个用英文逗号分隔（从 @userinfobot 获取）。
#
# 可以留空 —— 留空时，第一个向 Bot 发送 /bind 的用户会自动成为管理员。
# 填了的话这些人始终是管理员，可用于找回管理权，且不会被 /admin 降级。
#
# 安全提示：留空部署时，请尽快自己先 /bind 完成认领，
#           否则先找到这个 Bot 的陌生人会成为管理员。
ADMIN_TELEGRAM_IDS=

# ★ 主密钥，用于加密存储用户的 API Key。
#   生成：openssl rand -hex 32
#   ⚠️ 一旦设定不可更改 —— 改了以后所有用户已保存的 API Key 都无法解密，
#      用户需要重新 /ai set。请把它和数据库一起备份。
APP_MASTER_KEY=

# ─── 运行 ────────────────────────────────────────────────────────────────────

NODE_ENV=production
# 数据库路径，对应 compose 里挂载的 ./data
DB_PATH=/data/nodeseek.db
# 健康检查端口（仅容器内使用）
HEALTH_PORT=8787
# debug | info | warn | error
LOG_LEVEL=info

# ─── 轮询 ────────────────────────────────────────────────────────────────────

# 轮询间隔（毫秒），最小 10000
POLL_INTERVAL_MS=60000
# 单个 RSS 源请求超时
RSS_TIMEOUT_MS=15000
# 每个源的尝试次数
RSS_RETRIES=3
# 单轮最多处理多少条新帖（防止首次接入时刷屏）
MAX_POSTS_PER_ROUND=30
# 单用户单轮最多推几条，超出合并为汇总
MAX_PER_USER_PER_ROUND=10

# ─── 并发（多用户性能的核心旋钮）─────────────────────────────────────────────

# CPU 密集任务（XML 解析 + 正则匹配）的 worker 线程数。
#
# **一般不用设**。留空/删除本行时自动取值 max(2, min(4, 容器可用 CPU 数))，
# 用的是 os.availableParallelism() —— 它会读 cgroup 配额，而 os.cpus() 在
# 容器里报的是**宿主机**核数，照它配会在 1 核配额里开 4 个线程互相抢。
#
# 对照（compose 默认 cpus: "1.0"）：
#   cpus "1.0" → 有效值 2 线程      cpus "2.0" → 2 线程
#   cpus "3.0" → 3 线程             cpus "4.0" → 4 线程
#
# 只有在你明确要覆盖这个推导时才取消注释。设为 0 可禁用线程池，退化为
# 进程内计算（会失去 ReDoS 的硬超时保护）。
# WORKER_POOL_SIZE=4
# 单个计算任务超时；超时即判定为恶意正则并终止该 worker。
# 注意弱机器（或大关键词集）上正常任务也可能跑不完：实测 1 CPU 容器里
# 「4 万条关键词 × 30 帖」需 24.6 秒，会被这里判成恶意正则干掉。
WORKER_TASK_TIMEOUT_MS=5000
# 同时在飞的 AI 请求数
AI_CONCURRENCY=8
# Telegram 发送并发与全局速率（Bot API 上限约 30 条/秒）
SEND_CONCURRENCY=4
SEND_RATE_PER_SEC=20

# ─── 运行模式 ────────────────────────────────────────────────────────────────

# 多用户模式总开关。默认 false = 单用户模式。
#
#   false（默认）—— 只有管理员能用，/bind 仅对第一个用户开放（该用户即成为管理员）
#   true         —— 其他人可以 /bind 自助开通，各有独立的关键词与 AI 配置
#
# 管理员可以随时用 /admin multiuser on|off 在运行时切换，覆盖值会持久化到数据库，
# 并在后续启动时优先于本变量。用 /admin multiuser default 可清除覆盖、回到这里的设置。
MULTI_USER_ENABLED=false

# 多用户模式下是否允许新用户自助 /bind。关闭后仅管理员能开通。
# 注意：单用户模式下本项不生效。
REGISTRATION_OPEN=true

# ─── 多用户模式的防滥用 ──────────────────────────────────────────────────────
# 用户总数上限
MAX_USERS=200
# 新用户默认配额（管理员可对单个用户覆盖）
DEFAULT_MAX_KEYWORDS=20
# AI 配额 0 = 不限（默认不限制 AI 用量）
DEFAULT_DAILY_AI_QUOTA=0
DEFAULT_DAILY_PUSH_QUOTA=500
# 每用户每分钟最多发多少条命令
COMMAND_RATE_PER_MIN=20
# 绑定操作冷却秒数
BIND_COOLDOWN_SEC=30

# ─── 输入限制 ────────────────────────────────────────────────────────────────

MAX_KEYWORD_LEN=100
MAX_REGEX_LEN=500
MAX_PROMPT_LEN=1000
MAX_HISTORY_ROWS=20

# ─── 数据保留 ────────────────────────────────────────────────────────────────

# 【已废弃】已见记录自 2026-10-16 起改用水位线（每个「用户 × 源」一行，恒定量），
# 不再按时间清理。这个键保留只是兼容旧 .env，填了没有任何作用。
SEEN_RETENTION_DAYS=7
NOTIF_RETENTION_DAYS=30
USAGE_RETENTION_DAYS=90
# 清理任务间隔
CLEANUP_INTERVAL_MS=3600000
# 每次维护最多花多少毫秒清空「旧方案」遗留的 seen_posts 表。
# 老部署可能有 6000 万行 / 6 GiB，这里是分批删（实测约 8 万行/秒）；
# 时间预算的意义是绝不把主线程卡住（bot 与长轮询都在这条线程上）。
# 设 0 = 完全不清理。想立刻拿回磁盘空间请重建数据卷（docker compose down -v）。
LEGACY_SEEN_PURGE_MS=1500

# ─── 可选 ────────────────────────────────────────────────────────────────────

# 是否允许在群聊里使用（默认关闭，避免被当成公共机器人滥用）
ALLOW_GROUP_CHATS=false
